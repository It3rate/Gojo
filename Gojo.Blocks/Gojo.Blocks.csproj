<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.17" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.17" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.17" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gojo\Gojo.csproj" />
    <ProjectReference Include="..\Gojo.Encoding\Gojo.Encoding.csproj" />
    <ProjectReference Include="..\GojoCAD\GojoCAD.csproj" />
    <ProjectReference Include="..\GojoDraw\GojoDraw.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Tutorial\content\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Glossary\content\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Gojo.Encoding\Fixtures\EncoderJson\scene-mechanics\*.json">
      <Link>Glossary\content\en\scene-mechanics\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Tutorial\content\**\*" />
    <EmbeddedResource Include="Glossary\content\**\*" />
    <EmbeddedResource Include="..\Gojo.Encoding\Fixtures\EncoderJson\scene-mechanics\*.json">
      <Link>Glossary\content\en\scene-mechanics\%(Filename)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>

</Project>

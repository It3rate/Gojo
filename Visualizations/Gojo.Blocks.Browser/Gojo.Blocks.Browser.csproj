<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WasmBuildNative>true</WasmBuildNative>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" Version="12.0.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.0" />
    <PackageReference Include="Avalonia.Skia" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Gojo\Gojo.csproj" />
    <ProjectReference Include="..\..\Gojo.Encoding\Gojo.Encoding.csproj" />
    <ProjectReference Include="..\..\Applications\GojoCAD\GojoCAD.csproj" />
    <ProjectReference Include="..\..\Applications\GojoDraw\GojoDraw.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Gojo.Blocks\BlocksCanvas.cs" Link="Shared\BlocksCanvas.cs" />
    <Compile Include="..\Gojo.Blocks\BlocksContentRoot.cs" Link="Shared\BlocksContentRoot.cs" />
    <Compile Include="..\Gojo.Blocks\BlocksDocument.cs" Link="Shared\BlocksDocument.cs" />
    <Compile Include="..\Gojo.Blocks\BlocksTheme.cs" Link="Shared\BlocksTheme.cs" />
    <Compile Include="..\Gojo.Blocks\Glossary\*.cs" Link="Shared\Glossary\%(Filename)%(Extension)" />
    <Compile Include="..\Gojo.Blocks\Tutorial\*.cs" Link="Shared\Tutorial\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Gojo.Blocks\Tutorial\content\**\*">
      <Link>Tutorial\content\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\Gojo.Blocks\Glossary\content\**\*">
      <Link>Glossary\content\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\Gojo.Encoding\Fixtures\EncoderJson\scene-mechanics\*.json">
      <Link>Glossary\content\en\scene-mechanics\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <EmbeddedResource Include="..\Gojo.Blocks\Tutorial\content\**\*">
      <Link>Tutorial\content\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Gojo.Blocks\Glossary\content\**\*">
      <Link>Glossary\content\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\Gojo.Encoding\Fixtures\EncoderJson\scene-mechanics\*.json">
      <Link>Glossary\content\en\scene-mechanics\%(Filename)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>

</Project>

###############################################################################
# Set default behavior to automatically normalize line endings.
###############################################################################
* text=auto

# Keep Minds publication source fingerprints stable across operating systems.
/experiments/Minds/**/*.cs text eol=lf
/Tests/Minds.Tests/*.cs text eol=lf
/experiments/Minds/Presentation/*.html text eol=lf
/experiments/Minds/docs/*.md text eol=lf
/experiments/Minds/docs/ExperimentRoadmap.json text eol=lf
/Visualizations/Gojo.Demos.Web/tools/build-minds.mjs text eol=lf

# Preserve captured experiment bytes, including protocol checksums, across clones.
experiments/Minds/results/** -text -whitespace
Visualizations/Gojo.Demos.Web/minds/** -text whitespace=cr-at-eol

###############################################################################
# Set default behavior for command prompt diff.
#
# This is need for earlier builds of msysgit that does not have it on by
# default for csharp files.
# Note: This is only used by command line
###############################################################################
#*.cs     diff=csharp

###############################################################################
# Set the merge driver for project and solution files
#
# Merging from the command prompt will add diff markers to the files if there
# are conflicts (Merging from VS is not affected by the settings below, in VS
# the diff markers are never inserted). Diff markers may cause the following 
# file extensions to fail to load in VS. An alternative would be to treat
# these files as binary and thus will always conflict and require user
# intervention with every merge. To do so, just uncomment the entries below
###############################################################################
#*.sln       merge=binary
#*.csproj    merge=binary
#*.vbproj    merge=binary
#*.vcxproj   merge=binary
#*.vcproj    merge=binary
#*.dbproj    merge=binary
#*.fsproj    merge=binary
#*.lsproj    merge=binary
#*.wixproj   merge=binary
#*.modelproj merge=binary
#*.sqlproj   merge=binary
#*.wwaproj   merge=binary

###############################################################################
# behavior for image files
#
# image files are treated as binary by default.
###############################################################################
#*.jpg   binary
#*.png   binary
#*.gif   binary

###############################################################################
# diff behavior for common document formats
# 
# Convert binary document formats to text before diffing them. This feature
# is only available from the command line. Turn it on by uncommenting the 
# entries below.
###############################################################################
#*.doc   diff=astextplain
#*.DOC   diff=astextplain
#*.docx  diff=astextplain
#*.DOCX  diff=astextplain
#*.dot   diff=astextplain
#*.DOT   diff=astextplain
#*.pdf   diff=astextplain
#*.PDF   diff=astextplain
#*.rtf   diff=astextplain
#*.RTF   diff=astextplain


# Research preservation: retain captured bytes and source-checksum line endings.
/artifacts/** -text
**/TestResults/*.trx -text
/experiments/AdaptiveLifecycle/** -text
/Tests/AdaptiveLifecycle.Tests/** -text
/experiments/CompositeEmergence/** -text
/Tests/CompositeEmergence.Tests/** -text
/experiments/Phototaxis/** -text
/experiments/Phototaxis.Browser/** -text
/experiments/Phototaxis.Runner/** -text
/Tests/Phototaxis.Tests/** -text
/experiments/PrimitiveAgency/** -text
/experiments/PrimitiveForager/** -text
/Tests/PrimitiveForager.Tests/** -text
/experiments/PrimitiveLearning/** -text
/Tests/PrimitiveLearning.Tests/** -text
/experiments/RelativeSignals/** -text
/experiments/ResearchArchive/** -text
/experiments/SamplingEmergence/** -text
/experiments/UtilityEcology/** -text
/Tests/UtilityEcology.Tests/** -text
/Gojo/**/*.cs text eol=crlf
/Gojo/Structures/CoarseDifferencePlan.cs text eol=lf
/Gojo/Structures/CoarseReadSurface.cs text eol=lf
/Gojo/Structures/FiniteReadSurface.cs text eol=lf
/Gojo/Structures/RelativeSignalSurface.cs text eol=lf
/Gojo/Structures/SamplingSurface.cs text eol=lf
/Gojo/Structures/ScopedChoice.cs text eol=lf
/Gojo/Structures/SupportDecisionSurface.cs text eol=lf

# Native numeric archives are opaque transport, not line-oriented text.
*.gojo binary

# Preserve the captured browser-input hashes of the lattice research galleries.
/experiments/QualitativeFrieze/results/lattice-catalogue/** -text -whitespace
/experiments/QualitativeFrieze/results/lattice-transformations/** -text -whitespace
/experiments/QualitativeFrieze/results/lattice-interiors/** -text -whitespace

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <IsPackable>false</IsPackable>
    <Description>Small exploratory runs and observations of connected Gojo systems.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gojo\Gojo.csproj" />
    <ProjectReference Include="..\Gojo.Encoding\Gojo.Encoding.csproj" />
    <None Include="..\Gojo.Encoding.Tests\Fixtures\Syntax\two-space-feedback.gojo"
          Link="Fixtures\two-space-feedback.gojo" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Presentation\two-space.html" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Presentation\feedback-limits.html" CopyToOutputDirectory="PreserveNewest" />
    <None Update="docs\FeedbackLimitsProtocol.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Gojo.Encoding.Tests\Fixtures\Syntax\prospective-calibration.gojo"
          Link="Fixtures\prospective-calibration.gojo" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Presentation\predictions.html" CopyToOutputDirectory="PreserveNewest" />
    <None Update="docs\PredictionProtocol.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
